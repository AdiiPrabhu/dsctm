# --- Environments (not tracked; see requirements.txt) ---
venv/
.venv/
env/

# --- Large dataset (hosted on Kaggle, not in git) ---
dataset/

# --- Local tooling / editor config ---
.claude/
.idea/
.vscode/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- PARAM campaign: keep result roots tracked but never their payloads ---
results/**/runs/
results/**/*.pt
results/**/*.ckpt
results/**/*.parquet
results/**/*.npz

# --- Credentials: never commit, even accidentally ---
kaggle.json
.kaggle/
*.pem
*_token
*_TOKEN
.env
.env.*

# --- Offline wheel bundle: multi-GB, built locally, never committed ---
dsctm_wheels/
dsctm_wheels.tar.gz
dsctm_wheels.tar.gz.sha256
*.whl
